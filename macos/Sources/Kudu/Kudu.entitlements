<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime needs this to use the microphone. Kudu is not sandboxed:
	     Accessibility-based text insertion is not allowed in the App Sandbox. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
